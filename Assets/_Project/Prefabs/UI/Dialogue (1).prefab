--- !u!114 &1288527238267446814
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8495352006769209733}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 453df4e859648084e8bfaf1bb83c7498, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionRadius: 2
  interactIndicator: {fileID: 0}
  dialogueLines:
  - speakerName: Ember
    dialogueText: This is Yawadwipa Island
    speakerImageA: {fileID: 0}
    speakerImageB: {fileID: 1597602930, guid: 980c431e13a15ae46bc6637b2cdb9679, type: 3}
    isSpeakerAActive: 0
    disableClickToAdvance: 0
  - speakerName: Ember
    dialogueText: It used to be a beautiful place.
    speakerImageA: {fileID: 0}
    speakerImageB: {fileID: 1597602930, guid: 980c431e13a15ae46bc6637b2cdb9679, type: 3}
    isSpeakerAActive: 0
    disableClickToAdvance: 0
  - speakerName: Ember
    dialogueText: But something has changed.
    speakerImageA: {fileID: 0}
    speakerImageB: {fileID: 1597602930, guid: 980c431e13a15ae46bc6637b2cdb9679, type: 3}
    isSpeakerAActive: 0
    disableClickToAdvance: 0
  - speakerName: Aira
    dialogueText: What happened?
    speakerImageA: {fileID: 31115987, guid: 694cc5e7dc4c9f845b5dc5aad4fd231c, type: 3}
    speakerImageB: {fileID: 0}
    isSpeakerAActive: 1
    disableClickToAdvance: 0
  - speakerName: Ember
    dialogueText: A strange force has begun to consume this land.
    speakerImageA: {fileID: 0}
    speakerImageB: {fileID: 1597602930, guid: 980c431e13a15ae46bc6637b2cdb9679, type: 3}
    isSpeakerAActive: 0
    disableClickToAdvance: 0
  - speakerName: Ember
    dialogueText: One by one...
    speakerImageA: {fileID: 0}
    speakerImageB: {fileID: 1597602930, guid: 980c431e13a15ae46bc6637b2cdb9679, type: 3}
    isSpeakerAActive: 0
    disableClickToAdvance: 0
  - speakerName: Ember
    dialogueText: Every place is falling into darkness.
    speakerImageA: {fileID: 0}
    speakerImageB: {fileID: 1597602930, guid: 980c431e13a15ae46bc6637b2cdb9679, type: 3}
    isSpeakerAActive: 0
    disableClickToAdvance: 0
  - speakerName: Aira
    dialogueText: Can we stop it?
    speakerImageA: {fileID: 31115987, guid: 694cc5e7dc4c9f845b5dc5aad4fd231c, type: 3}
    speakerImageB: {fileID: 0}
    isSpeakerAActive: 1
    disableClickToAdvance: 0
  - speakerName: Ember
    dialogueText: We have to. If we don't... Everything will disappear.
    speakerImageA: {fileID: 0}
    speakerImageB: {fileID: 1597602930, guid: 980c431e13a15ae46bc6637b2cdb9679, type: 3}
    isSpeakerAActive: 0
    disableClickToAdvance: 0
  - speakerName: Aira
    dialogueText: Who's behind all of this?
    speakerImageA: {fileID: 31115987, guid: 694cc5e7dc4c9f845b5dc5aad4fd231c, type: 3}
    speakerImageB: {fileID: 0}
    isSpeakerAActive: 1
    disableClickToAdvance: 0
  - speakerName: Ember
    dialogueText: ...No one really knows.
    speakerImageA: {fileID: 0}
    speakerImageB: {fileID: 1597602930, guid: 980c431e13a15ae46bc6637b2cdb9679, type: 3}
    isSpeakerAActive: 0
    disableClickToAdvance: 0
  - speakerName: Ember
    dialogueText: But everyone calls it...
    speakerImageA: {fileID: 0}
    speakerImageB: {fileID: 1597602930, guid: 980c431e13a15ae46bc6637b2cdb9679, type: 3}
    isSpeakerAActive: 0
    disableClickToAdvance: 0
  - speakerName: Ember
    dialogueText: ...The Nightmare.
    speakerImageA: {fileID: 0}
    speakerImageB: {fileID: 1597602930, guid: 980c431e13a15ae46bc6637b2cdb9679, type: 3}
    isSpeakerAActive: 0
    disableClickToAdvance: 0
  - speakerName: Aira
    dialogueText: ...The Nightmare?
    speakerImageA: {fileID: 31115987, guid: 694cc5e7dc4c9f845b5dc5aad4fd231c, type: 3}
    speakerImageB: {fileID: 0}
    isSpeakerAActive: 1
    disableClickToAdvance: 0
  - speakerName: Ember
    dialogueText: Before it's too late...
    speakerImageA: {fileID: 0}
    speakerImageB: {fileID: 1597602930, guid: 980c431e13a15ae46bc6637b2cdb9679, type: 3}
    isSpeakerAActive: 0
    disableClickToAdvance: 0
  - speakerName: Ember
    dialogueText: We have to stop it from casting...
    speakerImageA: {fileID: 0}
    speakerImageB: {fileID: 1597602930, guid: 980c431e13a15ae46bc6637b2cdb9679, type: 3}
    isSpeakerAActive: 0
    disableClickToAdvance: 0
  - speakerName: Ember
    dialogueText: The Void Spell.
    speakerImageA: {fileID: 0}
    speakerImageB: {fileID: 1597602930, guid: 980c431e13a15ae46bc6637b2cdb9679, type: 3}
    isSpeakerAActive: 0
    disableClickToAdvance: 0
